# ---------------------------------------------------------------------------
# Сайт (Next.js)
# ---------------------------------------------------------------------------

# Canonical без завершающего слэша. При APP_ENV=production без него сборка падает.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Доменные имена, которые обслуживает gateway Nginx.
# SITE_DOMAIN=_ принимает любой Host — удобно для локального первого запуска.
SITE_DOMAIN=_
CMS_DOMAIN=cms.localhost

# production на VDS / в Docker web. Локальный pnpm build — не ставить.
APP_ENV=

# Хост ассетов Directus (только hostname, без протокола).
# Локально: localhost:8055  |  VDS: cms.example.ru
NEXT_PUBLIC_IMAGE_HOST=localhost:8055
# Empty = http for localhost and https for other domains. Set http when using
# the included HTTP-only Nginx gateway before TLS is enabled.
NEXT_PUBLIC_IMAGE_PROTOCOL=

# Яндекс.Метрика. Пусто — счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Внутренний URL Directus для серверного fetch.
# Локально (pnpm dev): http://localhost:8055
# В Docker-сети web→directus: http://directus:8055
DIRECTUS_URL=http://localhost:8055

# Static token роли Website (read). Выдаёт scripts/bootstrap-directus.mjs
DIRECTUS_TOKEN=

# Секрет для POST /api/revalidate (Directus Flow → webhook)
REVALIDATE_SECRET=change-me-revalidate-secret

# Если Directus недоступен — читать src/lib/content/site-content.ts
# На production-билде без Directus лучше не ставить (fail-fast).
CONTENT_FALLBACK=static

# ---------------------------------------------------------------------------
# PostgreSQL (Directus)
# ---------------------------------------------------------------------------

POSTGRES_USER=directus
POSTGRES_PASSWORD=directus-change-me
POSTGRES_DB=directus

# ---------------------------------------------------------------------------
# Directus
# ---------------------------------------------------------------------------

DIRECTUS_SECRET=replace-with-long-random-string
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me-admin-password

# Публичный URL админки (локально http://localhost:8055, на VDS https://cms.example.ru)
DIRECTUS_PUBLIC_URL=http://localhost:8055

# ---------------------------------------------------------------------------
# Bootstrap / seed (только для scripts/*)
# ---------------------------------------------------------------------------

# Тот же admin, что и DIRECTUS_ADMIN_* — скрипты логинятся и создают схему/контент
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

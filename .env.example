# =============================================================================
# VDS / production — hizhina-sakhalin.ru
# =============================================================================
# cp .env.example .env
# Затем обязательно замените все значения CHANGE_ME_* и задайте DIRECTUS_TOKEN
# после `pnpm bootstrap:directus`.
#
# Запуск:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# DNS: A/AAAA для @, www и cms → IP сервера.
# =============================================================================

# ---------------------------------------------------------------------------
# Сайт (Next.js)
# ---------------------------------------------------------------------------

APP_ENV=production

# Canonical без завершающего слэша (обязателен при APP_ENV=production).
NEXT_PUBLIC_SITE_URL=https://hizhina-sakhalin.ru

# Хост ассетов Directus (только hostname). Картинки: https://cms…/assets/…
NEXT_PUBLIC_IMAGE_HOST=cms.hizhina-sakhalin.ru
NEXT_PUBLIC_IMAGE_PROTOCOL=https

# Яндекс.Метрика. Пусто — счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# В рантайме web→directus compose подставляет внутренний http://directus:8055
# напрямую (без этой переменной). А вот на этапе сборки образа и с хоста
# (bootstrap/seed) сборщик/скрипты не в сети compose — нужен публичный URL CMS:
DIRECTUS_URL=https://cms.hizhina-sakhalin.ru

# Static token роли Website. Выдаёт: pnpm bootstrap:directus
DIRECTUS_TOKEN=

# Секрет webhook POST /api/revalidate (Directus Flow).
REVALIDATE_SECRET=CHANGE_ME_revalidate_secret_long_random

# На VDS пусто: без Directus страница не должна молча брать TS-fallback.
CONTENT_FALLBACK=

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Порты на хосте (с docker-compose.prod.yml web/directus снаружи не публикуются)
# ---------------------------------------------------------------------------

# WEB_PUBLISH=
# DIRECTUS_PUBLISH=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_USER=directus
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=directus

# ---------------------------------------------------------------------------
# Directus
# ---------------------------------------------------------------------------

DIRECTUS_SECRET=CHANGE_ME_directus_secret_long_random
DIRECTUS_ADMIN_EMAIL=admin@hizhina-sakhalin.ru
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_admin_password
DIRECTUS_PUBLIC_URL=https://cms.hizhina-sakhalin.ru

# ---------------------------------------------------------------------------
# Bootstrap / seed (с хоста; те же учётные данные admin)
# ---------------------------------------------------------------------------

BOOTSTRAP_ADMIN_EMAIL=admin@hizhina-sakhalin.ru
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---------------------------------------------------------------------------
# Обязательно на продакшне.
# Без этого адреса canonical, sitemap.xml и OG-теги укажут на localhost:3000.
# Билд на продовом окружении упадёт с явной ошибкой, а не уедет молча.
# Без завершающего слэша.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hizhina.example.ru

# ---------------------------------------------------------------------------
# Необязательно.
# ---------------------------------------------------------------------------

# Номер счётчика Яндекс.Метрики. Пусто — счётчик не подключается вовсе,
# поэтому на превью-деплоях и локально статистика не засоряется.
# Цели, которые нужно завести в интерфейсе Метрики (тип «JavaScript-событие»),
# перечислены в src/lib/analytics/goals.ts.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# Домен, откуда приходят фотографии, если их решат хранить не в репозитории.
# Только имя хоста, без протокола: cdn.example.ru
NEXT_PUBLIC_IMAGE_HOST=
